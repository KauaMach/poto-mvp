{
  "name": "poto-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/gravar-build-id.mjs",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings && npm run check-tokens && npm run check-prazos && npm run check-discreto && npm run check-contraste && npm run check-fila && npm run check-midia && npm run check-rotas",
    "check-tokens": "node scripts/verificar-tokens.mjs",
    "check-prazos": "node scripts/verificar-prazos.mjs",
    "check-discreto": "node scripts/verificar-discreto.mjs",
    "check-contraste": "node scripts/verificar-contraste.mjs",
    "check-fila": "node scripts/verificar-fila.mjs",
    "check-midia": "node scripts/verificar-midia.mjs",
    "check-rotas": "node scripts/verificar-rotas.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
