# P.O.T.O — configuração do backend
#
#   cp backend/.env.example backend/.env
#
# O `.env` NÃO vai para o repositório (está no .gitignore). Em produção, a
# unit systemd aponta para ele com EnvironmentFile=.

# ---------------------------------------------------------------------------
# Persistência
# ---------------------------------------------------------------------------
# Caminho do SQLite. Padrão: backend/poto.db
# POTO_DB_PATH=

# ---------------------------------------------------------------------------
# Triagem
# ---------------------------------------------------------------------------
# Artefato do classificador, gerado por `make setup`.
# Padrão: backend/app/data/triagem_clf.joblib
# Sem ele a triagem cai na heurística de palavras-chave — e o /health avisa.
# POTO_CLF_PATH=

# ---------------------------------------------------------------------------
# Frontend estático
# ---------------------------------------------------------------------------
# Onde está o build do Vite. Padrão: frontend/dist
# POTO_FRONTEND_DIST=

# ---------------------------------------------------------------------------
# Notificação
# ---------------------------------------------------------------------------
# log     — só registra no console e na tabela `notificacoes` (padrão; demo offline)
# webhook — POST para POTO_NOTIF_WEBHOOK_URL (Evolution API / n8n → WhatsApp)
POTO_NOTIF_PROVIDER=log

# POTO_NOTIF_WEBHOOK_URL=https://seu-endpoint/mensagem
# POTO_NOTIF_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Contatos dos canais
# ---------------------------------------------------------------------------
# NÃO HÁ VALOR PADRÃO. Canal sem contato configurado não é acionável, e o
# /health aponta quais estão faltando. Isso é deliberado: o projeto de
# referência trazia um celular real embutido no código-fonte.
#
# Formato conforme o provider (E.164 para WhatsApp/telefone, e-mail para os
# canais que atendem por e-mail).

POTO_CONTACT_CSV=
POTO_CONTACT_SALA_LILAS=
POTO_CONTACT_SAPSI=
POTO_CONTACT_OUVIDORIA=
POTO_CONTACT_SAMU=
POTO_CONTACT_PM=
POTO_CONTACT_BOMBEIROS=
POTO_CONTACT_180=

# TRAVA DE SEGURANÇA PARA TESTE E DEMONSTRAÇÃO.
# Preenchido, redireciona TODOS os canais para este único destino — impede
# acionar 190/192/193/180 de verdade durante os ensaios. Deixe vazio em produção.
POTO_CONTACT_OVERRIDE=

# ---------------------------------------------------------------------------
# SLA
# ---------------------------------------------------------------------------
# Intervalo, em segundos, entre as verificações de chamados sem ACK.
# Os prazos em si (120s imediato / 600s potencial) são do domínio, não de env.
POTO_SLA_CHECK_INTERVAL=30

# Intervalo com que o totem tenta drenar a fila offline. Exposto em /config
# para o frontend não duplicar a constante.
POTO_TOTEM_OFFLINE_SEG=15

# ---------------------------------------------------------------------------
# Segurança
# ---------------------------------------------------------------------------
# Token exigido no painel (/chamados*, /ws) via header X-POTO-Token.
# Vazio = modo desenvolvimento: libera o acesso e registra um aviso — e o
# /health passa a apontar `painel_protegido: false` em `avisos`, para que o
# modo desenvolvimento não chegue à operação real em silêncio.
#
# Os endpoints de acionamento (/eventos, /panico) NUNCA exigem token: um totem
# em pânico não pode falhar por credencial.
#
# O navegador não deixa definir cabeçalhos num `new WebSocket()`, então o /ws
# também aceita `?token=`. Prefira o cabeçalho quando puder — query string
# aparece em log de acesso.
POTO_PAINEL_TOKEN=

# Origens permitidas em CORS. Só importa em desenvolvimento, quando o Vite
# serve na 5173. Em produção a aplicação vem da mesma origem do backend.
# Nunca use "*".
POTO_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
